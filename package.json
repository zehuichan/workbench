{
  "name": "workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --environment happy-dom",
    "test:benchmark": "vitest bench --run --environment happy-dom",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "check": "pnpm lint && pnpm typecheck",
    "lint": "pnpm exec oxfmt --check --threads=4 . && pnpm exec oxlint --type-aware --threads=4 && pnpm exec eslint . && pnpm exec stylelint \"**/*.{vue,html,css}\"",
    "lint:fix": "pnpm format",
    "lint:style": "stylelint \"**/*.{vue,html,css}\"",
    "lint:style:fix": "stylelint \"**/*.{vue,html,css}\" --fix",
    "format": "pnpm exec stylelint \"**/*.{vue,html,css}\" --fix && pnpm exec oxfmt --threads=4 . && pnpm exec oxlint --fix --type-aware --threads=4 && pnpm exec eslint . --fix",
    "format:check": "pnpm exec oxfmt --check --threads=4 .",
    "commitlint": "commitlint --edit",
    "clean": "node ./scripts/clean.mjs",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@lucide/vue": "^1.55.0",
    "@vue/shared": "^3.5.43",
    "@vueuse/core": "^14.4.0",
    "@wecom/jssdk": "^2.4.4",
    "async-validator": "^4.2.5",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "element-plus": "^2.14.7",
    "es-toolkit": "^1.52.0",
    "modern-normalize": "^3.0.1",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.9",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "commitlint-plugin-function-rules": "^5.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "h3": "^2.0.8",
    "happy-dom": "^20.14.6",
    "jiti": "^2.7.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postcss-html": "^2.0.0",
    "sass-embedded": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.2",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4"
}
