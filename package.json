{
  "name": "workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --environment happy-dom",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "format": "prettier . --write --cache --log-level warn",
    "format:check": "prettier . --check --cache --log-level warn",
    "clean": "node ./scripts/clean.mjs",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "^1.55.0",
    "@vue/shared": "^3.5.43",
    "@vueuse/core": "^14.4.0",
    "@wecom/jssdk": "^2.4.4",
    "async-validator": "^4.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "element-plus": "^2.14.7",
    "es-toolkit": "^1.52.0",
    "modern-normalize": "^3.0.1",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@10.33.4"
}
